<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Goikon.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5862"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="19" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="sqlite_sequence" custom_title="0" dock_id="1" table="4,15:mainsqlite_sequence"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b6fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000011800ffffff000002670000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE Certificate (
    CertificateID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name VARCHAR NOT NULL,
    Issuer VARCHAR NOT NULL,
    YearsActiveFor INT NULL,
    Notes VARCHAR NULL
);

CREATE TABLE User (
    UserID INTEGER PRIMARY KEY AUTOINCREMENT,
    RoleID INTEGER NOT NULL,
    AccountType TEXT NOT NULL CHECK (AccountType IN ('Admin', 'Player', 'Team Manager', 'Referee')),
    Firstname VARCHAR(255) NOT NULL,
    Surname VARCHAR(255) NOT NULL,
    Password TEXT NOT NULL,
    Username TEXT NOT NULL UNIQUE,
    DateOfBirth DATE NOT NULL,
    Email TEXT NOT NULL UNIQUE,
    FOREIGN KEY (RoleID) REFERENCES Roles(RoleID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE TeamManager (
    ManagerID INT PRIMARY KEY,
    UserID INT NOT NULL,
    TeamID INT NOT NULL,
    Firstname VARCHAR(255) NOT NULL,
    Surname VARCHAR(255) NOT NULL,
    StartDate DATETIME NOT NULL,
    EndDate DATETIME,
    DateOfBirth DATE NOT NULL,
    Nationality VARCHAR(255) NOT NULL,
    ContactInfo VARCHAR(255) NOT NULL,
    FOREIGN KEY (UserID) REFERENCES User(UserID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (TeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE TeamManager_Certificate (
    ManagerID INTEGER NOT NULL,
    CertificateID INTEGER NOT NULL,
    IssueDate DATETIME NOT NULL,
    ExpiryDate DATETIME NULL,
    PRIMARY KEY (ManagerID, CertificateID),
    FOREIGN KEY (ManagerID) REFERENCES Managers(ManagerID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (CertificateID) REFERENCES Certificate(CertificateID) ON DELETE CASCADE ON UPDATE CASCADE
);


CREATE TABLE Player (
    PlayerID INT PRIMARY KEY,
    UserID INT NOT NULL,
    TeamID INT NOT NULL,
    Firstname VARCHAR(255) NOT NULL,
    Surname VARCHAR(255) NOT NULL,
    DateOfBirth DATE NOT NULL,
    Nationality VARCHAR(255) NOT NULL,
    Goals INT DEFAULT 0,
    Assists INT DEFAULT 0,
    RedCards INT DEFAULT 0,
    YellowCards INT DEFAULT 0,
    Appearances INT DEFAULT 0,
    FOREIGN KEY (UserID) REFERENCES User(UserID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (TeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Referee (
    RefereeID INTEGER PRIMARY KEY AUTOINCREMENT,
    UserID INTEGER NOT NULL,
    Firstname TEXT NOT NULL,
    Surname TEXT NOT NULL,
    PayPerHour INTEGER NOT NULL,
    DateOfBirth DATE NOT NULL,
    Nationality TEXT NOT NULL,
    ContactInfo TEXT NOT NULL,
    FOREIGN KEY (UserID) REFERENCES User(UserID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Referee_Certificate (
    RefereeID INTEGER NOT NULL,
    CertificateID INTEGER NOT NULL,
    IssueDate DATETIME NOT NULL,
    ExpiryDate DATETIME NULL,
    PRIMARY KEY (RefereeID, CertificateID),
    FOREIGN KEY (RefereeID) REFERENCES Referee(RefereeID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (CertificateID) REFERENCES Certificate(CertificateID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE FieldOwner (
    FieldOwnerID INTEGER PRIMARY KEY AUTOINCREMENT,
    Firstname VARCHAR(255),
    Surname VARCHAR(255),
    Email VARCHAR(255),
);

CREATE TABLE Field (
    FieldID INT PRIMARY KEY,
    FieldOwnerID INT NOT NULL,
    Name VARCHAR(255) NOT NULL,
    PricePerHour INT NOT NULL,
    Location VARCHAR(255) NOT NULL,
    OpeningHours DATETIME,
    ClosingHours DATETIME,
    Capacity INT,
    FOREIGN KEY (FieldOwnerID) REFERENCES FieldOwner(UserID) ON DELETE CASCADE ON UPDATE CASCADE
);


CREATE TABLE Team (
    TeamID INTEGER PRIMARY KEY AUTOINCREMENT,
    LeagueID INTEGER NOT NULL,
    ManagerID INTEGER NOT NULL,
    FieldID INTEGER NOT NULL,
    TeamName VARCHAR(255) NOT NULL,
    FOREIGN KEY (LeagueID) REFERENCES League(LeagueID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (ManagerID) REFERENCES Manager(ManagerID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (FieldID) REFERENCES Field(FieldID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Maintenance (
    MaintenanceID INTEGER PRIMARY KEY AUTOINCREMENT,
    FieldID INTEGER NOT NULL,
    MaintenanceType VARCHAR(255) NOT NULL,
    StartDate DATETIME NOT NULL,
    EndDate DATETIME NOT NULL,
    Description VARCHAR(255),
    Status TEXT NOT NULL,
    FOREIGN KEY (FieldID) REFERENCES Field(FieldID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE League_Match (
    LeagueMatchID INTEGER PRIMARY KEY AUTOINCREMENT,
    LeagueID INTEGER NOT NULL,
    HomeTeamID INTEGER NOT NULL,
    AwayTeamID INTEGER NOT NULL,
    MatchReportID INTEGER NOT NULL,
    RefBookingID INTEGER NOT NULL,
    MatchDate DATETIME NOT NULL,
    Venue VARCHAR NOT NULL,
    Status TEXT NOT NULL CHECK(Status IN ('Scheduled', 'Ongoing', 'Completed', 'Cancelled')),
    FOREIGN KEY (LeagueID) REFERENCES League(LeagueID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (HomeTeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (AwayTeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (MatchReportID) REFERENCES MatchReport(MatchReportID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (RefBookingID) REFERENCES RefBooking(RefBookingID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Friendly_Match (
    FriendlyMatchID INTEGER PRIMARY KEY AUTOINCREMENT,
    FieldID INTEGER NOT NULL,
    TeamID INTEGER NOT NULL,
    RefBookingID INTEGER NOT NULL,
    MatchReportID INTEGER NOT NULL,
    OpposingTeamID INTEGER NOT NULL,
    Time DATETIME NOT NULL,
    Status TEXT NOT NULL CHECK(Status IN ('Scheduled', 'Ongoing', 'Completed', 'Cancelled')),
    FOREIGN KEY (FieldID) REFERENCES Field(FieldID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (TeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (RefBookingID) REFERENCES RefBooking(RefBookingID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (MatchReportID) REFERENCES Match_Report_Log(MatchReportID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (OpposingTeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Match_Report_Log (
    MatchReportID INTEGER PRIMARY KEY AUTOINCREMENT,
    RefBookingID INTEGER NOT NULL,
    FriendlyMatchID INTEGER NULL,
    LeagueMatchID INTEGER NULL,
    TeamID INTEGER NOT NULL,
    PlayerID INTEGER NOT NULL,
    PlayerNumber INTEGER NOT NULL,
    Event TEXT NOT NULL CHECK(Event IN ('Goal', 'Yellow Card', 'Red Card', 'Substitution', 'Injury')),
    Time INTEGER NOT NULL,
    Reason VARCHAR NULL,
    FOREIGN KEY (RefBookingID) REFERENCES RefBooking(RefBookingID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (FriendlyMatchID) REFERENCES Friendly_Match(FriendlyMatchID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (LeagueMatchID) REFERENCES League_Match(LeagueMatchID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (TeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (PlayerID) REFERENCES Player(PlayerID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Referee_Report (
    RefereeID INTEGER PRIMARY KEY AUTOINCREMENT,
    TeamManagerID INTEGER NOT NULL,
    MatchReportID INTEGER NOT NULL,
    Rating INTEGER,
    Notes VARCHAR,
    Date DATETIME,
    FOREIGN KEY (TeamManagerID) REFERENCES Team_Manager(TeamManagerID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (MatchReportID) REFERENCES Match_Report_Log(MatchReportID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Referee_Booking (
    RefBookingID INTEGER PRIMARY KEY AUTOINCREMENT,
    RefereeID INTEGER NOT NULL,
    MatchStart DATETIME NOT NULL,
    MatchEnd DATETIME NOT NULL,
    Status TEXT NOT NULL CHECK(Status IN ('Scheduled', 'Completed', 'Cancelled')),
    Notes VARCHAR NULL,
    FOREIGN KEY (RefereeID) REFERENCES Referee(RefereeID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Roster (
    RosterID INTEGER PRIMARY KEY AUTOINCREMENT,
    LeagueMatchID INTEGER NOT NULL,
    TeamID INTEGER NOT NULL,
    PlayerID INTEGER NOT NULL,
    Position VARCHAR NOT NULL,
    ShirtNumber INTEGER NOT NULL,
    FOREIGN KEY (LeagueMatchID) REFERENCES League_Match(LeagueMatchID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (TeamID) REFERENCES Team(TeamID) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (PlayerID) REFERENCES Player(PlayerID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Activity (
    ActivityLogID INTEGER PRIMARY KEY AUTOINCREMENT,
    UserID INTEGER NOT NULL,
    LastLogin DATETIME NULL,
    IsActive BOOLEAN NULL,
    FOREIGN KEY (UserID) REFERENCES Users(UserID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Roles (
    RoleID INTEGER PRIMARY KEY AUTOINCREMENT,
    PermissionID INT NOT NULL,
    Name VARCHAR NOT NULL,
    Description VARCHAR NOT NULL,
    FOREIGN KEY (PermissionID) REFERENCES Permissions(PermissionID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Permissions (
    PermissionID INTEGER PRIMARY KEY AUTOINCREMENT
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
